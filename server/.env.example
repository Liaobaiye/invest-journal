PORT=3000
NODE_ENV=development

# JWT secrets (required in production, min 32 chars)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32

# Admin seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS origin for the static frontend
FRONTEND_URL=http://localhost:8080

# 站点对外完整地址（邮件/历史报告链接用；默认 http://localhost:PORT）
# PUBLIC_BASE_URL=http://localhost:3000

# ===== 代理（国内访问 OKX / Binance 必配）=====
# Clash / V2Ray / Shadowsocks 本地端口，按你的客户端修改
# 注意：Binance 会拒绝美国出口 IP（HTTP 451），请选 香港 / 日本 / 新加坡 / 台湾 节点
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

# ===== 邮件通知（告警/稳定币脱钩/山寨币自动扫描）=====
# 163/QQ/Gmail 按域名自动选 SMTP；授权码非登录密码
# EMAIL_USER=your-email@163.com
# EMAIL_AUTH_CODE=your-smtp-auth-code
# EMAIL_TO=your-email@163.com

# Optional exchange credentials / AI
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# AI_API_BASE_URL=https://api.deepseek.com/v1
# AI_API_KEY=
# AI_MODEL=deepseek-chat
